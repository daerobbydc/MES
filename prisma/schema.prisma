// MAINTENANCE SCHEDULING
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
model MaintenanceSchedule {
  id              String   @id @default(uuid())
  machineId       String
  type            MaintenanceType
  title           String
  description     String?
  intervalHours   Int?
  intervalDays    Int?
  nextDueDate     DateTime
  lastCompletedAt DateTime?
  assignedTo      String?
  priority        Priority @default(MEDIUM)
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  machine  Machine @relation(fields: [machineId], references: [id])
  tasks    MaintenanceTask[]
}

model MaintenanceTask {
  id               String   @id @default(uuid())
  scheduleId       String?
  machineId        String
  type             MaintenanceType
  title            String
  description      String?
  status           MaintenanceTaskStatus @default(PENDING)
  assignedTo       String?
  startedAt        DateTime?
  completedAt      DateTime?
  cost             Float    @default(0)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  schedule MaintenanceSchedule? @relation(fields: [scheduleId], references: [id])
  machine  Machine @relation(fields: [machineId], references: [id])
}

enum MaintenanceType {
  PREVENTIVE
  CORRECTIVE
  PREDICTIVE
  INSPECTION
}

enum MaintenanceTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  OVERDUE
}

// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
// SHIFT MANAGEMENT
// â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•â•
model ShiftDefinition {
  id          String   @id @default(uuid())
  name        String
  startTime   String
  endTime     String
  isOvernight Boolean  @default(false)
  breakMinutes Int    @default(60)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  schedules ShiftSchedule[]
}

model ShiftSchedule {
  id              String   @id @default(uuid())
  shiftId         String
  userId          String
  date            DateTime
  status          ShiftStatus @default(ASSIGNED)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  shift ShiftDefinition @relation(fields: [shiftId], references: [id])
  user  User            @relation(fields: [userId], references: [id])

  @@unique([shiftId, userId, date])
}

enum ShiftStatus {
  ASSIGNED
  CHECKED_IN
  CHECKED_OUT
  ABSENT
  SWAPPED
}

